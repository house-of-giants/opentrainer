{
  "name": "opentrainer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @opentrainer/web build",
    "lint": "bun run --filter @opentrainer/web lint",
    "typecheck": "bun run --filter '@opentrainer/*' typecheck",
    "test": "bun test apps/web packages && bun run test:mobile",
    "test:mobile": "cd apps/mobile && bunx jest"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}