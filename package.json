{
  "name": "opentrainer",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run --filter @opentrainer/web build",
    "lint": "bun run --filter @opentrainer/web lint",
    "typecheck": "bun run --filter '@opentrainer/*' typecheck",
    "test": "bun test"
  },
  "ignoreScripts": ["sharp", "unrs-resolver"],
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
